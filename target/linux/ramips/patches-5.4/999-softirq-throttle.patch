+static inline int check_softirq_throttled(u64 start_time)
+{
+	u64 now = ktime_get_mono_fast_ns();
+	u64 p_start = __this_cpu_read(si_time_start);
+	u64 used = __this_cpu_read(si_time_used);
+	u64 blocked = __this_cpu_read(si_blocked_until);
+	u64 chunk = now - start_time;
+
+	if (blocked && now < blocked) {
+		return 1;
+	} else if (blocked) {
+		__this_cpu_write(si_blocked_until, 0);
+		__this_cpu_inc(softirq_stats_data.free_cnt);
+	}
+
+	used += chunk;
+
+        if (si_throttle.runtime != (u64)-1LL && used >= si_throttle.runtime) {
+                __this_cpu_write(si_blocked_until, now + (u64)sysctl_softirq_block_ms * 1000000ULL);
+                __this_cpu_inc(softirq_stats_data.block_cnt);
+                return 1;
+        }
+
+        if (now - p_start >= si_throttle.period) {
+                __this_cpu_write(si_time_start, now);
+                __this_cpu_write(si_time_used, chunk);
+                return 0;
+        }
+
+	__this_cpu_write(si_time_used, used);
+	return 0;
+}
