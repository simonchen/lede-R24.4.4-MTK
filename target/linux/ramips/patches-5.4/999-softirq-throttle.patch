+static int softirq_throttle_validate(void)
+{
+	if (((int)sysctl_softirq_period_ms <= 0) ||
+	    (sysctl_softirq_block_ms <= 0) ||
+	      (sysctl_softirq_block_ms > sysctl_softirq_period_ms) ||
+	    ((sysctl_softirq_runtime_ms != -1) &&
+	     ((unsigned int)sysctl_softirq_runtime_ms > sysctl_softirq_period_ms)) ||
+	    (sysctl_softirq_throttle_mask > 3))
+		return -EINVAL;
+	return 0;
+}
+
+static void softirq_throttle_update(void)
+{
+	unsigned long flags;
+	raw_spin_lock_irqsave(&si_throttle.lock, flags);
+	si_throttle.period = (u64)sysctl_softirq_period_ms * 1000000ULL;
+	si_throttle.runtime = (sysctl_softirq_runtime_ms == -1) ?
+		(u64)-1LL : (u64)sysctl_softirq_runtime_ms * 1000000ULL;
+	raw_spin_unlock_irqrestore(&si_throttle.lock, flags);
+}
+
+int softirq_throttle_handler(struct ctl_table *table, int write, void *buffer,
+			     size_t *lenp, loff_t *ppos)
+{
+	unsigned int old_period, old_runtime, old_block, old_mask;
+	static DEFINE_MUTEX(mutex);
+	int ret;
+
+	mutex_lock(&mutex);
+	old_period = sysctl_softirq_period_ms;
+	old_runtime = sysctl_softirq_runtime_ms;
+	old_block = sysctl_softirq_block_ms;
+	old_mask = sysctl_softirq_throttle_mask;
+
+	ret = proc_dointvec(table, write, buffer, lenp, ppos);
+	if (ret) goto undo;
+	if (!write) goto done;
+
+	ret = softirq_throttle_validate();
+	if (ret) goto undo;
+
+	softirq_throttle_update();
+	goto done;
+
+undo:
+	sysctl_softirq_period_ms = old_period;
+	sysctl_softirq_runtime_ms = old_runtime;
+	sysctl_softirq_block_ms = old_block;
+	sysctl_softirq_throttle_mask = old_mask;
+done:
+	mutex_unlock(&mutex);
+	return ret;
+}
+
+int sysctl_softirq_stats_handler(struct ctl_table *table, int write, void *buffer,
