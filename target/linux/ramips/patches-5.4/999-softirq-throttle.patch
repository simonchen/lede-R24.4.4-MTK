+static DEFINE_PER_CPU(struct sk_buff_head, mtk_batch_queue);
+static DEFINE_PER_CPU(u8, mtk_batch_count) = 0;
+static DEFINE_PER_CPU(u64, last_flush_ns) = 0;
+
+int sysctl_rx_enable_batch = 0;
+unsigned int sysctl_rx_batch_us = 10;
+unsigned int sysctl_rx_max_batch_cnt = 4;
+DEFINE_PER_CPU(u64, rx_success_batch_sum) = 0;
+
+static int __netif_rx_internal(struct sk_buff *skb, bool flush)
+{
+	int ret = NET_RX_SUCCESS;
+	unsigned int batch_cnt;
+	struct sk_buff_head *batch_q;
+	u64 now_ns;
+
+	if (skb) {
+		net_timestamp_check(READ_ONCE(netdev_tstamp_prequeue), skb);
+	}
+
+#ifdef CONFIG_RPS
+	preempt_disable();
+#endif
+	batch_q = this_cpu_ptr(&mtk_batch_queue);
+
+	if (unlikely(!batch_q->next)) {
+		skb_queue_head_init(batch_q);
+	}
+
+	if (skb) {
+		__skb_queue_tail(batch_q, skb);
+		__this_cpu_inc(mtk_batch_count);
+	}
+	batch_cnt = __this_cpu_read(mtk_batch_count);
+
+	now_ns = ktime_get_mono_fast_ns();
+
+	if (!flush && likely(batch_cnt < sysctl_rx_max_batch_cnt && 
+		(now_ns - __this_cpu_read(last_flush_ns)) < sysctl_rx_batch_us*1000)) {
+#ifdef CONFIG_RPS
+		preempt_enable();
+#endif
+		return NET_RX_SUCCESS;
+	}
+
+#ifdef CONFIG_RPS
+	rcu_read_lock();
+#endif
+	__this_cpu_write(last_flush_ns, now_ns);
+
+	while ((skb = __skb_dequeue(batch_q))) {
+#ifdef CONFIG_RPS
+		if (static_branch_unlikely(&rps_needed)) {
+			struct rps_dev_flow voidflow, *rflow = &voidflow;
+			int cpu;
+
+			cpu = get_rps_cpu(skb->dev, skb, &rflow);
+			if (cpu < 0)
+				cpu = smp_processor_id();
+			ret = enqueue_to_backlog(skb, cpu, &rflow->last_qtail);
+		} else
+#endif
+		{
+			unsigned int qtail;
+			ret = enqueue_to_backlog(skb, smp_processor_id(), &qtail);
+			put_cpu();
+		}
+	}
+
+	if (batch_cnt >= sysctl_rx_max_batch_cnt)
+		__this_cpu_inc(rx_success_batch_sum); // actual aggr num!
+	__this_cpu_write(mtk_batch_count, 0);
+
+#ifdef CONFIG_RPS
+	rcu_read_unlock();
+	preempt_enable();
+#endif
+	return ret;
+}
