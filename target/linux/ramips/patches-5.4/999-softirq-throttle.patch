+		 "throttle_mask *BIT(0) NET_TX_SOFTIRQ / *BIT(1) NET_RX_SOFTIRQ : " COLOR_WHITE "%u\n" COLOR_RESTORE
+		 "period_ms  : " COLOR_WHITE "%u ms\n" COLOR_RESTORE
+		 "runtime_ms : " COLOR_WHITE "%d ms\n" COLOR_RESTORE
+		 "block_ms   : " COLOR_WHITE "%u ms\n\n" COLOR_RESTORE
+		 COLOR_BLUE "=== Per-CPU Live Telemetry Stats ===\n" COLOR_RESTORE
+		 "cpu_id    blocked_count    freed_count    rx_blocked    tx_blocked    rcu_skipped\n",
+		 sysctl_softirq_throttle_mask,
+		 sysctl_softirq_period_ms, 
+		 sysctl_softirq_runtime_ms, 
+		 sysctl_softirq_block_ms);
+
+	for_each_possible_cpu(cpu) {
+		u64 b_cnt = per_cpu(softirq_stats_data, cpu).block_cnt;
+		u64 f_cnt = per_cpu(softirq_stats_data, cpu).free_cnt;
+		u64 rx_cnt = per_cpu(softirq_stats_data, cpu).rx_block_cnt;
+		u64 tx_cnt = per_cpu(softirq_stats_data, cpu).tx_block_cnt;
+		u64 rcu_cnt = per_cpu(softirq_stats_data, cpu).rcu_skip_cnt;
+
+		snprintf(buf + strlen(buf), total_len - strlen(buf), "cpu %d:    " COLOR_YELLOW "%-20llu" COLOR_GREEN "  %-15llu" COLOR_YELLOW "%-14llu" "%-14llu" COLOR_GREEN "%-15llu" COLOR_RESTORE "\n",
+			       cpu, b_cnt, f_cnt, rx_cnt, tx_cnt, rcu_cnt);
+	}
+
+	table->data = buf;
+	table->maxlen = strlen(buf) + 1;
+	ret = proc_dostring(table, write, buffer, lenp, ppos);
+
+	kfree(buf);
+	mutex_unlock(&stats_mutex);
+
+	return ret;
+}
