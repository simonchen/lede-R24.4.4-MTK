+		return -ENOMEM;
+	}
+#define COLOR_GREEN	"\033[32m"
+#define COLOR_YELLOW	"\033[33m"
+#define COLOR_BLUE	"\033[36m"
+#define COLOR_RESTORE	"\033[0m"
+#define COLOR_WHITE	"\033[1m"
